[Unit]
Description=MetaScope Goal-All Runner
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/metascope
EnvironmentFile=/etc/metascope/goal-all.env
ExecStart=/bin/bash /opt/metascope/scripts/vps/run-goal-all.sh
Restart=on-failure
RestartSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
