{
  "name": "@metascope/api",
  "private": true,
  "version": "0.1.0",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start:staging": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "vitest run",
    "test:integration": "vitest run src/modules/webhook-trust-chain/postgres-repositories.integration.spec.ts",
    "test:integration:with-db": "bash ../../scripts/run-api-integration-with-db.sh",
    "db:migrate": "bash ../../scripts/run-api-migrations.sh"
  },
  "dependencies": {
    "express": "^4.21.2",
    "ioredis": "^5.10.1",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vitest": "^3.2.4"
  }
}
